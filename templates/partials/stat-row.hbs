<div class="crw-stat-row">
  <span class="crw-stat-abbr">{{abbr}}</span>
  <span class="crw-stat-name">{{fullName}}</span>
  <button type="button" class="crw-stat-btn" data-action="statDec" data-stat="{{key}}">−</button>
  <span class="crw-stat-value" data-stat="{{key}}">{{value}}</span>
  <button type="button" class="crw-stat-btn" data-action="statInc" data-stat="{{key}}">+</button>
</div>
