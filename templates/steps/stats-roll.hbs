<div class="crw-step-stats">
  <div class="crw-roll-header">
    <span class="crw-label">{{roleName}} — Stat Template</span>
    <button type="button" class="crw-btn-roll" data-action="rollStats">
      <i class="fas fa-dice-d20"></i>
      {{#if (eq method "streetrat")}}
        {{localize "crw.stats.roll"}}
      {{else}}
        {{localize "crw.stats.rollAll"}}
      {{/if}}
    </button>
  </div>

  {{#if rollResult}}
  <div class="crw-roll-result">
    <span class="crw-roll-label">{{localize "crw.stats.rollResult"}}:</span>
    {{#if (eq method "streetrat")}}
    <span class="crw-roll-value">{{rollResult}}</span>
    <span class="crw-roll-row">→ {{localize "crw.stats.row"}} {{rollResult}}</span>
    {{else}}
    <span class="crw-roll-value">[{{rollResult}}]</span>
    {{/if}}
  </div>
  {{/if}}

  <div class="crw-stat-grid">
    {{#each statRows}}
    <div class="crw-stat-cell">
      <div class="crw-stat-abbr">{{abbr}}</div>
      <input type="number" class="crw-stat-cell-value" data-stat="{{key}}" value="{{value}}" min="1" max="10">
    </div>
    {{/each}}
  </div>

  <div class="crw-hint">
    <i class="fas fa-pencil-alt"></i> {{localize "crw.stats.overrideHint"}}
    {{#if (eq method "edgerunner")}}
    <br>{{localize "crw.stats.edgerunnerHint"}}
    {{/if}}
  </div>
</div>
