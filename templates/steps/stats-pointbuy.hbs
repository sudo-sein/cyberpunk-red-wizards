<div class="crw-step-stats">
  <div class="crw-budget-header">
    <span class="crw-label">{{localize "crw.stats.title"}}</span>
    <div>
      <span class="crw-budget-value">{{remaining}}</span>
      <span class="crw-budget-label"> / 62 {{localize "crw.stats.remaining"}}</span>
    </div>
  </div>
  <div class="crw-budget-bar">
    <div class="crw-budget-fill" style="width: {{spentPercent}}%"></div>
  </div>

  <div class="crw-stat-list">
    {{#each statRows}}
    {{> "modules/cyberpunk-red-wizards/templates/partials/stat-row.hbs"}}
    {{/each}}
  </div>

  <div class="crw-hint">{{localize "crw.stats.hint"}}</div>
</div>
